<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/Laynative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible">

        <com.google.android.gms.ads.nativead.NativeAdView
            android:id="@+id/native_ad_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_collapsible_native_card">

            <!-- Vertical stack: collapsing the media just removes it, the rest stays put -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Chevron (top-right) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/btn_collapse"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="end"
                        android:contentDescription="Collapse ad"
                        android:padding="2dp"
                        android:src="@drawable/ic_collapse_chevron" />
                </FrameLayout>

                <!-- Collapsible media area -->
                <FrameLayout
                    android:id="@+id/media_card"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_collapsible_media_card"
                    android:padding="16dp">

                    <com.google.android.gms.ads.nativead.MediaView
                        android:id="@+id/media_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <!-- Info row: icon + headline/body + "Ad" badge -->
                <LinearLayout
                    android:id="@+id/info_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:lines="1"
                            android:text="Shopify: Sell online/in person"
                            android:textColor="#E91E63"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Run your business wherever you are."
                            android:textColor="@color/gray"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ad_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_ad_badge_orange"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="Ad"
                        android:textColor="@color/white_color"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Gradient "Install" CTA -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/cta"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_native_collapsible_cta"
                    android:gravity="center"
                    android:lines="1"
                    android:text="Install"
                    android:textAllCaps="false"
                    android:textColor="@color/white_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.gms.ads.nativead.NativeAdView>

        <include
            android:id="@+id/footer"
            layout="@layout/load_fb_native_collapsible" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
