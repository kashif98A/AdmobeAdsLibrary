<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_container_native"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    app:shimmer_auto_start="true"
    app:shimmer_base_color="#E0E0E0"
    app:shimmer_highlight_color="#F8F8F8">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <View
            android:id="@+id/ph_badge"
            android:layout_width="34dp"
            android:layout_height="18dp"
            android:background="@color/lightTransparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/ph_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_full_native_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ph_badge" />

        <View
            android:id="@+id/ph_title"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:background="@color/lightTransparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ph_icon"
            app:layout_constraintTop_toTopOf="@+id/ph_icon" />

        <View
            android:id="@+id/ph_sub"
            android:layout_width="120dp"
            android:layout_height="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:background="@color/lightTransparent"
            app:layout_constraintStart_toEndOf="@+id/ph_icon"
            app:layout_constraintTop_toBottomOf="@+id/ph_title" />

        <View
            android:id="@+id/ph_media"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_full_native_icon"
            app:layout_constraintBottom_toTopOf="@+id/ph_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ph_icon" />

        <View
            android:id="@+id/ph_body"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/lightTransparent"
            app:layout_constraintBottom_toTopOf="@+id/ph_cta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/ph_cta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_full_native_cta"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
